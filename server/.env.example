# Server environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=7002
CLIENT_URL=http://localhost:7001

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_view
DB_USER=root
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp          # smtp | google | outlook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@examview.com

# ── WhatsApp ──────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://wa.officall.ceoitbox.com
WHATSAPP_API_KEY=

# ── Google Maps ───────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7002/api/v1/auth/google/callback

# ── Microsoft OAuth ───────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:7002/api/v1/auth/microsoft/callback

# ── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100
